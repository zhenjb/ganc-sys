                  "pm.test('deposit contract', function () { const j = pm.response.json(); pm.expect(j.txHash).to.match(/^0x/); pm.expect(j.depositRecord.depositId).to.eql('dep-1'); pm.expect(j.state.depositStatus).to.eql('locked'); });"
