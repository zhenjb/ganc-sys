{
  "info": {
    "name": "GANC System Backend API \u2014 INT-01 to INT-04",
    "description": "Postman collection for current GANC/ZKDEX backend API. Batch-shaped contracts: deposits[], withdrawals[], batchCommitments, witness.accounts[], withdrawRecords[].",
